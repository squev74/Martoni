# GEMINI_API_KEY: Clé API Google Gemini injectée automatiquement côté serveur dans Google AI Studio
# (configurable dans le panneau Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Variable d'environnement optionnelle pour configuration locale Vite (.env.local).
# Si aucune clé n'est définie ou si l'appel échoue, le jeu bascule automatiquement sur les réponses de secours de questions.json.
VITE_GEMINI_API_KEY="VOTRE_CLE_API_GEMINI_ICI"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
